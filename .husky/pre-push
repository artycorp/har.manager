#!/bin/sh

# Git pre-push hook to run tests before pushing to main
# Managed by husky - https://typicode.github.io/husky

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# Get current branch
current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

# Get remote ref being pushed
while read local_ref local_sha remote_ref remote_sha
do
  # Check if pushing to main branch
  if [ "$remote_ref" = "refs/heads/main" ]; then
    printf "${CYAN}╔════════════════════════════════════════════════╗${NC}\n"
    printf "${CYAN}║  Pre-push tests for main branch                ║${NC}\n"
    printf "${CYAN}╠════════════════════════════════════════════════╣${NC}\n"
    printf "${YELLOW}Running all tests before push to main...${NC}\n\n"

    # Run Vitest tests
    printf "${CYAN}[1/2] Running Vitest (unit + component + store)...${NC}\n"
    npm test -- --run --reporter=basic
    vitest_exit=$?

    if [ $vitest_exit -ne 0 ]; then
      printf "\n${RED}╔════════════════════════════════════════════════╗${NC}\n"
      printf "${RED}║  ❌ Vitest tests FAILED                         ║${NC}\n"
      printf "${RED}╠════════════════════════════════════════════════╣${NC}\n"
      printf "${RED}║  Push to main BLOCKED                          ║${NC}\n"
      printf "${RED}║  Fix failing tests before pushing              ║${NC}\n"
      printf "${RED}╚════════════════════════════════════════════════╝${NC}\n\n"
      exit 1
    fi

    printf "\n${GREEN}✓ Vitest tests passed (182/182)${NC}\n\n"

    # Run Playwright E2E tests
    printf "${CYAN}[2/2] Running Playwright E2E tests...${NC}\n"
    npm run test:e2e -- --reporter=list
    playwright_exit=$?

    if [ $playwright_exit -ne 0 ]; then
      printf "\n${RED}╔════════════════════════════════════════════════╗${NC}\n"
      printf "${RED}║  ❌ Playwright E2E tests FAILED                 ║${NC}\n"
      printf "${RED}╠════════════════════════════════════════════════╣${NC}\n"
      printf "${RED}║  Push to main BLOCKED                          ║${NC}\n"
      printf "${RED}║  Fix failing tests before pushing              ║${NC}\n"
      printf "${RED}╚════════════════════════════════════════════════╝${NC}\n\n"
      exit 1
    fi

    printf "\n${GREEN}✓ Playwright E2E tests passed (22/22)${NC}\n\n"

    # All tests passed
    printf "${GREEN}╔════════════════════════════════════════════════╗${NC}\n"
    printf "${GREEN}║  ✅ All tests PASSED (204/204)                  ║${NC}\n"
    printf "${GREEN}╠════════════════════════════════════════════════╣${NC}\n"
    printf "${GREEN}║  Push to main allowed ✓                        ║${NC}\n"
    printf "${GREEN}╚════════════════════════════════════════════════╝${NC}\n\n"
  fi
done

exit 0
