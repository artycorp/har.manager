#!/bin/sh

# Git pre-push hook to run tests before pushing to main
# Managed by husky - https://typicode.github.io/husky
#
# Usage:
#   git push                    # Native execution (fast)
#   USE_DOCKER=1 git push       # Docker execution (isolated)
#   git push --no-verify        # Skip tests (use with caution)

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'

# Configuration
USE_DOCKER=${USE_DOCKER:-0}

# Get current branch
current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

# Get remote ref being pushed
while read local_ref local_sha remote_ref remote_sha
do
  # Check if pushing to main branch
  if [ "$remote_ref" = "refs/heads/main" ]; then
    printf "${CYAN}╔════════════════════════════════════════════════╗${NC}\n"
    printf "${CYAN}║  Pre-push tests for main branch                ║${NC}\n"
    printf "${CYAN}╠════════════════════════════════════════════════╣${NC}\n"

    if [ "$USE_DOCKER" = "1" ]; then
      printf "${MAGENTA}║  Mode: Docker (isolated environment)           ║${NC}\n"
    else
      printf "${YELLOW}║  Mode: Native (fast)                            ║${NC}\n"
    fi

    printf "${CYAN}╚════════════════════════════════════════════════╝${NC}\n\n"

    # Change to repository root
    cd "$(git rev-parse --show-toplevel)" || exit 1

    # Run test-runner.sh script
    if [ ! -f "./test-runner.sh" ]; then
      printf "${RED}Error: test-runner.sh not found${NC}\n"
      printf "${YELLOW}Falling back to direct npm test execution...${NC}\n\n"

      # Fallback to direct execution
      npm test -- --run && npm run test:e2e
      test_exit=$?
    else
      # Run test-runner.sh with USE_DOCKER environment variable
      USE_DOCKER=$USE_DOCKER ./test-runner.sh
      test_exit=$?
    fi

    if [ $test_exit -ne 0 ]; then
      printf "${RED}╔════════════════════════════════════════════════╗${NC}\n"
      printf "${RED}║  ❌ Tests FAILED - Push to main BLOCKED         ║${NC}\n"
      printf "${RED}╠════════════════════════════════════════════════╣${NC}\n"
      printf "${RED}║  Fix failing tests before pushing              ║${NC}\n"
      printf "${RED}║                                                 ║${NC}\n"
      printf "${RED}║  Options:                                       ║${NC}\n"
      printf "${RED}║  • Fix tests and try again                      ║${NC}\n"
      printf "${RED}║  • USE_DOCKER=1 git push (isolated env)         ║${NC}\n"
      printf "${RED}║  • git push --no-verify (skip tests)            ║${NC}\n"
      printf "${RED}╚════════════════════════════════════════════════╝${NC}\n\n"
      exit 1
    fi

    printf "${GREEN}╔════════════════════════════════════════════════╗${NC}\n"
    printf "${GREEN}║  ✅ All tests PASSED - Push to main allowed     ║${NC}\n"
    printf "${GREEN}╚════════════════════════════════════════════════╝${NC}\n\n"
  fi
done

exit 0
